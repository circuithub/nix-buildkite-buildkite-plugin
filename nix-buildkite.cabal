cabal-version:       2.0
name:                nix-buildkite
version:             0.1.0.0
license-file:        LICENSE
author:              CircuitHub
maintainer:          oliver.charles@circuithub.com
build-type:          Simple
extra-source-files:  CHANGELOG.md, README.md, scripts/build-all.sh

library
  exposed-modules:     NixBuildkite
  hs-source-dirs:      src
  build-depends:       aeson 
                     , algebraic-graphs 
                     , base 
                     , bytestring 
                     , containers 
                     , filepath 
                     , directory 
                     , process 
                     , text 
                     , attoparsec 
                     , nix-derivation 
                     , clock 
                     , template-haskell 
  default-language:    Haskell2010
  ghc-options:         -Wcompat -Wall

executable nix-buildkite
  main-is:             Main.hs
  build-depends:       base 
                     , aeson 
                     , bytestring 
                     , nix-buildkite
  default-language:    Haskell2010
  hs-source-dirs:      exe-nix-buildkite
  ghc-options:         -Wcompat -Wall

test-suite nix-buildkite-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:       base 
                     , aeson 
                     , nix-buildkite
                     , tasty
                     , tasty-hunit
                     , text 
                     , vector
  default-language:    Haskell2010
  ghc-options:         -Wcompat -Wall
